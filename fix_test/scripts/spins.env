# Load points: the client's inter-send spin count per message size, lowest
# load first, the last one 0 (flat out). Copied from q1's calibrated
# scripts/knee_spins.env (maple01's client, unchanged here). Override one size
# with FT_SPINS_<size>="..." in the environment.
: "${FT_POINTS:=8}"
: "${FT_SPINS_128:=7700 2300 630 330 160 89 24 0}"
: "${FT_SPINS_1024:=6700 1800 330 110 31 11 2 0}"
: "${FT_SPINS_4096:=9200 2900 740 340 130 58 25 0}"
: "${FT_SPINS_16384:=14000 5300 1900 1100 530 330 180 0}"
